# PrecisionCalc MCP -- environment variable reference (copy to .env for local use)

# --- Transport (HTTP only) ---
PRECISIONCALC_HOST=127.0.0.1
PRECISIONCALC_PORT=8000

# --- Auth & rate limiting (HTTP only) ---
# Comma-separated API keys. If empty => open mode (no auth), still metered + rate-limited by IP.
PRECISIONCALC_API_KEYS=
PRECISIONCALC_RATE_LIMIT_PER_MIN=120
PRECISIONCALC_RATE_LIMIT_BURST=40
PRECISIONCALC_METRICS_PATH=/metrics

# --- Foreign exchange ---
# static (default, offline/deterministic) or frankfurter (live+historical ECB rates)
PRECISIONCALC_FX_PROVIDER=static
PRECISIONCALC_FX_TTL=3600
PRECISIONCALC_FX_TIMEOUT=4

# --- Observability ---
PRECISIONCALC_LOG_LEVEL=INFO
PRECISIONCALC_LOG_JSON=1
PRECISIONCALC_OTEL=0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
